<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ====== Permissions required for emulation + pairing + workshop ====== -->

    <!-- Pairing proxy: bind TCP 7889 (foreground service) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <!-- Foreground service (post-Android 14 typed) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- v0.5.32 (audit L1): removed unused FOREGROUND_SERVICE_DATA_SYNC
         permission declaration — our foreground service uses the "specialUse"
         type (see the <service> declaration below), not "dataSync". Play
         Store only checks that you have the permission for the type you
         actually use, so declaring an unused type is just bloat. The
         FOREGROUND_SERVICE_SPECIAL_USE permission below is the one we
         actually need (it's matched to the service's foregroundServiceType
         attribute). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Wake lock so the Wine process doesn't sleep mid-render -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Keep Wi-Fi alive for the (rare) LAN-pair fallback -->

    <!-- Multicast lock for UDP 7884 + 239.100.0.1 (if user enables mDNS discovery fallback) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- v0.7.1 (round 6 — pairing persistence): RECEIVE_BOOT_COMPLETED so the
         BootReceiver can auto-start the pairing foreground service after a
         device reboot or after an app update. Without this, the pairing
         service wouldn't be running until the user manually opened the app,
         so the phone couldn't pair with the computer after a reboot.
         Android EXEMPTS BOOT_COMPLETED + MY_PACKAGE_REPLACED from the
         Android 12+ background-foreground-service-start restriction, and
         our `specialUse` foreground service type is NOT in the Android 15+
         restricted-types list — so the receiver can start our service. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Notification permission (Android 13+) for the foreground service sticky notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Storage: read/write workshop wallpapers + .mpkg outbox -->
    <!-- Scoped storage on Android 10+; we use app-specific external storage (no permission needed) -->
    <!-- But for the official WE Android app to find the .mpkg outbox, we may need to expose via FileProvider -->

    <!-- WRITE_EXTERNAL_STORAGE for Android 9 and below so we can write crash logs
         and boot breadcrumbs to the public Downloads/WallpaperSuite/ directory via legacy
         File API. On Android 10+ we use MediaStore (no permission needed). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Root detection: query SU binary — no permission needed but uses Runtime.exec -->
    <!-- (no manifest declaration required) -->

    <!-- ====== v0.8.0: integrated Wallpaper Engine (live wallpaper) ====== -->
    <!-- Set/inspect the live wallpaper -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Audio-responsive wallpapers: system-mix Visualizer (runtime-requested) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Gyroscope parallax at >200Hz (official client declares this too) -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- ====== Hardware/features — declare so Play filters work (though we sideload) ====== -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <!-- v0.8.0: the WE engine renders through OpenGL ES 3.0 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- Live wallpaper support is optional (the workshop browser + import still work without it) -->
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <!-- Vulkan 1.3 required (Adreno 740+ on SD8Gen2) — use android:version, NOT glEsVersion -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="131072" android:required="true" />
    <!-- Adreno 740+ Vulkan 1.3 — we can't enforce this at install time, but document it -->

    <!-- v0.7.1: Query the Wallpaper Engine Android app package for auto-launch -->
    <queries>
        <package android:name="io.wallpaperengine.weclient" />
        <package android:name="com.wallpaper.engine" />
        <package android:name="com.fws.wallpaperengine" />
    </queries>

    <application
        android:name=".WepWawetApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WepWawet"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <!-- ====== Main UI ====== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WepWawet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v0.8.0: manual import — open .mpkg / .bin wallpaper packages from
                 file managers (same filter set as the official WE client). -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.mpkg" />
                <data android:mimeType="application/prs.mpkg" />
                <data android:mimeType="application/mpkg" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mpkg" />
                <data android:pathPattern=".*\\..*\\.mpkg" />
                <data android:pathPattern=".*\\..*\\..*\\.mpkg" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.mpkg" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.mpkg" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.mpkg" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.mpkg" />
                <data android:pathPattern=".*\\.bin" />
                <data android:pathPattern=".*\\..*\\.bin" />
                <data android:pathPattern=".*\\..*\\..*\\.bin" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.bin" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.bin" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.bin" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.bin" />
            </intent-filter>
        </activity>

        <!-- ====== Steam login (WebView, separate Activity so it has its own back-stack) ====== -->
        <!--
            configChanges prevents the WebView from being destroyed on rotation,
            which would lose the user's in-progress login. launchMode=singleTop
            prevents stacking multiple SteamLoginActivity instances.
        -->
        <activity
            android:name=".auth.SteamLoginActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.WepWawet" />

        <!-- ====== Foreground services ====== -->

        <!--
            Pairing Proxy Service — owns UDP 7884 + TCP 7889.
            
            Type: specialUse — this is a long-running foreground service that
            doesn't fit the standard types (dataSync would time out on
            Android 14+ because the proxy is meant to run indefinitely while
            the app is in use, not just for a single sync operation).
            
            Per Android 14+ (API 34+), we declare the use case in <property>.
            Per Android docs: "For long-running services, use the specialUse
            foreground service type" — exactly our case (a TCP server that
            the WE Android app connects to for wallpaper pairing/transfer).

            v0.7.1 (round 6): `specialUse` is NOT in the Android 15+
            restricted-types list (dataSync, camera, mediaPlayback,
            phoneCall, microphone) — so BOOT_COMPLETED can still start
            this service on Android 15+. Combined with the new
            BootReceiver + RECEIVE_BOOT_COMPLETED permission, the pairing
            service now auto-restarts after a device reboot or app update.
        -->
        <service
            android:name=".pairing.PairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a Wallpaper Engine pairing proxy (UDP 7884 discovery + TCP 7889 RSA/AES handshake + .mpkg wallpaper transfer) so the official Wallpaper Engine Android app can pair with this device and receive wallpapers." />
        </service>

        <!--
            v0.7.1 (round 6 — pairing persistence): BootReceiver — auto-restart
            the pairing foreground service after a device reboot or after an
            app update.

            Android EXEMPTS BOOT_COMPLETED + MY_PACKAGE_REPLACED from the
            Android 12+ background-foreground-service-start restriction.
            Combined with the `specialUse` foreground service type (which
            is NOT in the Android 15+ restricted-types list), this receiver
            can start the PairingService even on the latest Android.

            exported="true" is REQUIRED for system-broadcast receivers —
            the system delivers BOOT_COMPLETED/MY_PACKAGE_REPLACED via
            the package's exported receiver entry. (Android 12+ requires
            `android:exported` to be explicitly set on all components with
            intent filters.)
        -->
        <receiver
            android:name=".pairing.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ====== v0.8.0: the integrated Wallpaper Engine live wallpaper service ====== -->
        <!--
            Full port of the official client's WEWallpaperService: renders Scene
            wallpapers through libscenejni.so and Video/Image/GIF wallpapers
            through the ported GL pipeline, with playlist support, power-saving
            pause and per-wallpaper properties. Registered exactly like the
            official service (BIND_WALLPAPER + wallpaper meta-data resource).
        -->
        <service
            android:name="io.wallpaperengine.weclient.WEWallpaperService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:enabled="true"
            android:exported="true"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/we_wallpaper" />
        </service>

        <!-- ====== FileProvider — expose the .mpkg outbox so the official WE app could read it if it needs to ====== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ====== WorkManager — log persistence ====== -->
        <!-- Remove default WorkManager initializer since we use Configuration.Provider -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
