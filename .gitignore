# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/

# Gradle files
.gradle/
.cxx/
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
captures/

# Keystore (the debug keystore IS committed so all CI builds share a key;
# release keystores should be kept locally and never committed)
*.jks
!debug.keystore

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.pem

# Downloaded workshop content (used during local testing only)
*.mpkg
*.pkg
!**/build/**
# v0.8.0: the bundled official WE wallpapers ARE shipped in the APK
!app/src/main/assets/wallpapers/**

# Native build outputs (regenerated by CMake/NDK)
*.so
!app/src/main/**/lib*/**
# v0.8.0: the prebuilt WE engine must be committed (NOT regenerated by CMake)
!app/src/main/jniLibs/**

# Backup files
*.bak
*.orig
*.rej

# Editor / agent tooling
.claude
.z-ai-config
.zscripts/

# Agent-local scratch dirs (NEVER commit these — they're for the agent's
# own research/diffing/tool-results, and the user has repeatedly told me
# not to push them. v0.5.6-alpha cleanup deleted these from origin/main
# but they kept coming back as untracked when I worked locally.)
tool-results/
upload/
research/
research-1b/
research-cache/
scripts/
skills/
# v0.8.2: the engine's JS script runtime (assets/scripts/) is SHIPPED in the
# APK — the bare `scripts/` pattern above silently ignored it, exactly like
# the *.so/*.mpkg incident that shipped an engine-less release once before.
# The DIRECTORY itself must be re-included before git will look inside it.
!app/src/main/assets/scripts/
!app/src/main/assets/scripts/**
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Download dir (user-visible APK artifacts; never commit binaries — they
# bloat the repo by 16MB per build and trigger GitHub LFS warnings).
download/

# Worklog (kept locally for agent reminders; CI doesn't need it)
# (We DO commit worklog.md so future agents can read it.)

.kotlin/
